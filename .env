# Vite environment variables
# Base URL for your .NET Core API (no trailing slash)
# Adjust the port to match your backend launch profile.
VITE_API_BASE_URL=https://localhost:7164/api

# Item images are uploaded to the Azure host, so point image URLs there even when the API runs locally.
# VITE_API_IMAGE_BASE_URL=https://localhost:7164/
VITE_API_IMAGE_BASE_URL=https://axisapiwebapp-fvh5e7bda3aag0g7.francecentral-01.azurewebsites.net/

# For HTTP (if TLS disabled) you could instead use:
# VITE_API_BASE_URL=http://localhost:5000/api
